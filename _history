type=\"variables_get\"><field name=\"VAR\" id=\"jI{zj5l(F,{TjeU6GVFD\">newXDer</field></block></value><next><block type=\"mecanumRobotV2_Motor\"><field name=\"M\">LR.Lower_right</field><field name=\"D\">MD.Back</field><value name=\"speed\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"100\" label=\"Speed\" precision=\"0\"></mutation><field name=\"SLIDER\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"jI{zj5l(F,{TjeU6GVFD\">newXDer</field></block></value></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"// Movimiento hacia atrás\nfunction car_back () {\n    mecanumRobotV2.Motor(LR.Upper_left, MD.Back, newYAba)\n    mecanumRobotV2.Motor(LR.Lower_left, MD.Back, newYAba)\n    mecanumRobotV2.Motor(LR.Upper_right, MD.Back, newYAba)\n    mecanumRobotV2.Motor(LR.Lower_right, MD.Back, newYAba)\n}\n// Movimiento lateral hacia la izquierda\nfunction car_left () {\n    mecanumRobotV2.Motor(LR.Upper_left, MD.Back, nexXIzq)\n    mecanumRobotV2.Motor(LR.Lower_left, MD.Back, nexXIzq)\n    mecanumRobotV2.Motor(LR.Upper_right, MD.Forward, nexXIzq)\n    mecanumRobotV2.Motor(LR.Lower_right, MD.Forward, nexXIzq)\n}\n// Movimiento hacia adelante\nfunction car_forward () {\n    mecanumRobotV2.Motor(LR.Upper_left, MD.Forward, newYArr)\n    mecanumRobotV2.Motor(LR.Lower_left, MD.Forward, newYArr)\n    mecanumRobotV2.Motor(LR.Upper_right, MD.Forward, newYArr)\n    mecanumRobotV2.Motor(LR.Lower_right, MD.Forward, newYArr)\n}\n// Recepción de mensajes de texto\nradio.onReceivedString(function (receivedString) {\n    control.inBackground(function () {\n        basic.showString(receivedString)\n    })\n})\n// Recepción de los valores del control\nradio.onReceivedValue(function (name, value) {\n    if (name == \"x\") {\n        velX = value\n    } else if (name == \"y\") {\n        velY = value\n    } else if (name == \"claxon\") {\n        claxon = value\n    } else {\n    \t\n    }\n})\n// Movimiento lateral hacia la derecha\nfunction car_right () {\n    mecanumRobotV2.Motor(LR.Upper_left, MD.Forward, newXDer)\n    mecanumRobotV2.Motor(LR.Lower_left, MD.Forward, newXDer)\n    mecanumRobotV2.Motor(LR.Upper_right, MD.Back, newXDer)\n    mecanumRobotV2.Motor(LR.Lower_right, MD.Back, newXDer)\n}\nlet newXDer = 0\nlet claxon = 0\nlet newYArr = 0\nlet nexXIzq = 0\nlet newYAba = 0\nlet velY = 0\nlet velX = 0\nradio.setGroup(6)\nvelX = 50\nvelY = 50\ndfplayermini.connect(SerialPin.P12, SerialPin.P13)\ndfplayermini.setVolume(30)\ndfplayermini.playFile(0, dfplayermini.isRepeat.No)\n// Control de movimiento\nbasic.forever(function () {\n    // Calcular velocidades\n    newXDer = Math.map(velX, 60, 100, 0, 30)\n    nexXIzq = Math.map(velX, 40, 0, 0, 30)\n    newYArr = Math.map(velY, 60, 100, 0, 100)\n    newYAba = Math.map(velY, 40, 0, 0, 100)\n    // Determinar dirección\n    if (velY >= 60) {\n        car_forward()\n    } else if (velY <= 40) {\n        car_back()\n    } else if (velX <= 40) {\n        car_left()\n    } else if (velX >= 60) {\n        car_right()\n    } else {\n        mecanumRobotV2.state()\n    }\n    basic.pause(20)\n    if (claxon == 1) {\n        dfplayermini.playFile(0, dfplayermini.isRepeat.No)\n    }\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"recibe aucontrol\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-mecanum-robot-V2\": \"github:keyestudio2019/mecanum_robot_v2#f161a000ae13c11373ee2549d0a6147e103ff3cf\",\n        \"dfplayermini\": \"github:51bit/dfplayermini#v0.1.6\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v4.0.11\",\n        \"tag\": \"v4.0.11\",\n        \"commits\": \"https://github.com/microsoft/pxt-microbit/commits/2b9dd6f9b1588b4ad95673b458b3a6eb156bfbd7\",\n        \"target\": \"4.0.11\",\n        \"pxt\": \"7.0.8\"\